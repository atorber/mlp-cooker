# 服务器配置
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# 日志配置
LOG_LEVEL=debug

# 后端API配置
# 北京: aihc.bj.baidubce.com
# 广州: aihc.gz.baidubce.com
# 苏州: aihc.su.baidubce.com
# 保定: aihc.bd.baidubce.com
# 武汉: aihc.fwh.baidubce.com
# 阳泉: aihc.yq.baidubce.com
BACKEND_ENDPOINT_BJ=aihc.bj.baidubce.com
BACKEND_ENDPOINT_GZ=aihc.gz.baidubce.com
BACKEND_ENDPOINT_SU=aihc.su.baidubce.com
BACKEND_ENDPOINT_BD=aihc.bd.baidubce.com

# 百度云认证
BAIDU_CLOUD_AK=your-access-key
BAIDU_CLOUD_SK=your-secret-key

# 缓存配置（可选）
REDIS_URL=redis://localhost:6379
CACHE_TTL=300

# 限流配置
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
